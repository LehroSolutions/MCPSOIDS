{
  "name": "mcpsoids-server",
  "version": "1.0.0",
  "description": "MCPSOIDS Server - Optimized Reference Implementation of the Model Context Protocol",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/**",
    "bin/**"
  ],
  "bin": {
    "mcp-server-ref": "bin/mcp-server-ref.js"
  },
  "scripts": {
    "dev": "ts-node src/cli.ts",
    "start": "ts-node src/cli.ts --enable-fs --cors-allow-all",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "inspector": "ts-node scripts/inspector.ts",
    "stress": "ts-node scripts/stress_test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "agent",
    "protocol"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "pino": "^10.1.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.27",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}