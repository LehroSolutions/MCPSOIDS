{
  "name": "mcpsoids-server",
  "version": "1.0.0",
  "description": "MCPSOIDS Server - Optimized Reference Implementation of the Model Context Protocol",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/**",
    "bin/**"
  ],
  "bin": {
    "mcp-server-ref": "bin/mcp-server-ref.js"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "start": "bun src/cli.ts --enable-fs --cors-origin http://localhost:3001",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "inspector": "bun scripts/inspector.ts",
    "stress": "bun scripts/stress_test.ts",
    "prepublishOnly": "bun run build",
    "package:manager": "bun --version",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,yml,yaml}\""
  },
  "keywords": [
    "mcp",
    "agent",
    "protocol"
  ],
  "author": "Lehro Solutions",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "8.6.2",
    "pino": "10.3.1",
    "uuid": "9.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "pino-pretty": "13.1.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "prettier": "3.5.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14"
  }
}
