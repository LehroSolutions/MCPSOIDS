{
  "name": "mcpsoids",
  "private": true,
  "version": "1.0.0",
  "description": "MCPSOIDS monorepo root \u2014 Bun workspace for mcp_server_ref",
  "license": "Apache-2.0",
  "author": "Lehro Solutions",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "cd mcp_server_ref && bun run dev",
    "start": "cd mcp_server_ref && bun run start",
    "build": "cd mcp_server_ref && bun run build",
    "lint": "cd mcp_server_ref && bun run lint",
    "install:js": "bun install",
    "package:manager": "bun --version",
    "docs:build": "node scripts/docs.mjs build",
    "docs:check": "node scripts/docs.mjs check",
    "format": "cd mcp_server_ref && bun run format",
    "format:check": "cd mcp_server_ref && bun run format:check"
  },
  "workspaces": [
    "mcp_server_ref"
  ]
}
